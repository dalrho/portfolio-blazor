@using MyApp.Web.Client.Models

<div class="project-card">
    <div class="card-top">
        <span class="card-index">
            @Project.Index
        </span>
        <span class="card-year">
            @Project.Year
        </span>
    </div>
    
    <h3 class="card-title">
        @Project.Name
    </h3>
    
    <p class="card-summary">
        @Project.Summary
    </p>
    
    <div class="tech-tags">
        @foreach (var tech in Project.Tech)
        {
            <span class="tech-tag">
                @tech
            </span>
        }
    </div>
    
    <div class="card-actions">
        <a href="@Project.Live" class="link-primary">
            [ LIVE DEMO ]
        </a>
        <a href="@Project.Github" class="link-secondary">
            [ GITHUB ]
        </a>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Project Project { get; set; } = default!;
}