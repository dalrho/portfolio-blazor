@page "/"
@rendermode InteractiveAuto
@inject IJSRuntime JS
@using MyApp.Web.Client.Models
@using MyApp.Web.Client.Components

<div>
    <!-- Navigation Bar -->
    <nav class="fixed top-0 left-0 right-0 h-14 bg-canvas border-b border-border-subtle flex items-center justify-between px-8 lg:px-16 z-50">
        <button @onclick="@(() => NavigateTo("home"))" class="font-display text-sm font-bold tracking-[0.1em] text-white bg-transparent border-none cursor-pointer uppercase transition-colors duration-150 hover:text-accent">
            AK
        </button>
        <div class="flex items-center gap-6 lg:gap-8">
            @foreach (var p in Pages)
            {
                <button @onclick="@(() => NavigateTo(p))"
                        class="font-mono text-xs tracking-[0.1em] uppercase bg-transparent border-none cursor-pointer transition-colors duration-150 @(currentPage == p ? "text-accent" : "text-muted hover:text-white")">
                    [ @(p == "about" ? "ABOUT" : p == "reviews" ? "REVIEWS" : p.ToUpperInvariant()) ]
                </button>
            }
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="pt-14">
        @if (currentPage == "home")
        {
            <div class="anim-fade">
                <!-- Hero Section -->
                <section class="relative min-h-[90vh] flex flex-col justify-end pt-24 pb-16 px-8 lg:px-16 border-b border-border-subtle overflow-hidden">
                    <div class="font-display text-border-subtle text-[clamp(6rem,20vw,18rem)] leading-none absolute top-12 -right-[0.02em] select-none font-extrabold -tracking-[0.04em] pointer-events-none">01</div>

                    <div class="relative z-10 max-w-[65rem]">
                        <p class="font-mono text-muted text-xs uppercase tracking-[0.15em] mb-8 anim-1">01 / HOME</p>
                        <h1 class="font-display font-extrabold leading-[0.95] -tracking-[0.03em] text-[clamp(2.5rem,7vw,6.5rem)] uppercase text-white mb-8 anim-2">
                            BUILDING AT THE<br />
                            INTERSECTION OF<br />
                            <span class="text-accent">CODE</span> &amp; <span class="font-serif italic font-normal">CULTURE</span>
                        </h1>
                        <p class="font-mono text-muted max-w-[52ch] text-sm leading-[1.7] mb-12 anim-3">
                            Full-stack engineer &amp; AI researcher. I build systems that feel inevitable — fast, legible, and obsessively considered. Based in San Francisco.
                        </p>
                        <div class="flex flex-wrap gap-4 anim-4">
                            <button @onclick="@(() => NavigateTo("work"))" class="font-mono border border-accent bg-accent text-canvas px-8 py-3.5 text-xs tracking-[0.15em] font-bold cursor-pointer uppercase inline-block transition-colors duration-150 hover:bg-canvas hover:text-accent">
                                [ VIEW WORK ]
                            </button>
                            <button @onclick="@(() => NavigateTo("reviews"))" class="font-mono border border-border-subtle bg-surface text-white px-8 py-3.5 text-xs tracking-[0.15em] font-bold cursor-pointer uppercase inline-block transition-colors duration-150 hover:border-accent hover:text-accent">
                                [ RATE &amp; REVIEW ★ ]
                            </button>
                        </div>
                    </div>
                </section>

                <!-- Stats Grid -->
                <section class="border-b border-border-subtle anim-5">
                    <div class="grid grid-cols-2 lg:grid-cols-4">
                        @for (int i = 0; i < stats.Length; i++)
                        {
                            var stat = stats[i];
                            <div class="p-8 lg:py-10 lg:px-8 border-border-subtle border-b [&:nth-child(odd)]:border-r [&:nth-child(n+3)]:border-b-0 lg:border-b-0! lg:border-r! lg:last:border-r-0!">
                                <div class="font-display font-extrabold -tracking-[0.03em] text-white text-[clamp(2rem,5vw,3.5rem)]">@stat.Value</div>
                                <div class="font-mono text-muted text-xs mt-2 leading-[1.5] uppercase tracking-[0.1em] whitespace-pre-line">@stat.Label</div>
                            </div>
                        }
                    </div>
                </section>

                <!-- Selected Work -->
                <section class="px-8 py-16 lg:px-16 anim-6">
                    <div class="flex items-baseline justify-between mb-10">
                        <h2 class="font-display font-bold -tracking-[0.02em] text-xl uppercase text-white">SELECTED WORK</h2>
                        <button @onclick="@(() => NavigateTo("work"))" class="font-mono text-muted text-xs uppercase tracking-[0.1em] bg-transparent border-none cursor-pointer transition-colors duration-150 hover:text-accent">
                            [ VIEW ALL → ]
                        </button>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        @foreach (var project in projects.Take(4))
                        {
                            <ProjectCard Project="@project" />
                        }
                    </div>
                </section>
            </div>
        }
        else if (currentPage == "work")
        {
            <div class="anim-fade">
                <!-- Work Header -->
                <section class="relative px-8 pt-20 pb-12 lg:px-16 border-b border-border-subtle overflow-hidden">
                    <div class="font-display text-border-subtle text-[clamp(6rem,20vw,18rem)] leading-none absolute top-12 -right-[0.02em] select-none font-extrabold -tracking-[0.04em] pointer-events-none">02</div>
                    <p class="font-mono text-muted text-xs uppercase tracking-[0.15em] mb-8 anim-1">02 / WORK</p>
                    <h1 class="font-display font-extrabold -tracking-[0.03em] text-[clamp(2.5rem,5vw,3.75rem)] text-white uppercase mb-10 anim-2">PROJECT<br />ARCHIVE</h1>

                    <div class="flex flex-wrap gap-3 anim-3">
                        @foreach (var f in filters)
                        {
                            <button @onclick="@(() => currentFilter = f)"
                                    class="font-mono border px-5 py-2 text-[0.7rem] tracking-[0.12em] cursor-pointer uppercase transition-all duration-150 @(currentFilter == f ? "border-accent bg-accent text-canvas" : "border-border-subtle bg-transparent text-muted hover:border-white hover:text-white")">
                                [ @f ]
                            </button>
                        }
                    </div>
                </section>

                <!-- Filtered Project List -->
                <section class="border-b border-border-subtle anim-4">
                    @{
                        var filtered = currentFilter == "ALL" 
                            ? projects 
                            : projects.Where(p => p.Tags.Contains(currentFilter)).ToList();
                    }
                    @foreach (var p in filtered)
                    {
                        <div class="flex flex-col lg:grid lg:grid-cols-[80px_1fr_auto] lg:items-start gap-6 p-8 lg:px-16 border-b border-border-subtle last:border-b-0 bg-transparent transition-colors duration-150 hover:bg-surface">
                            <div class="font-mono text-accent text-sm font-bold pt-1">@p.Index</div>
                            <div>
                                <div class="flex items-center gap-4 flex-wrap mb-2">
                                    <h3 class="font-display font-bold -tracking-[0.02em] text-xl text-white uppercase">@p.Name</h3>
                                    @foreach (var tag in p.Tags)
                                    {
                                        <span class="font-mono border border-border-subtle text-muted px-2 py-0.5 text-[0.65rem] tracking-[0.1em] uppercase">@tag</span>
                                    }
                                </div>
                                <p class="font-mono text-muted max-w-[60ch] text-xs leading-[1.6] mb-4">@p.Summary</p>
                                <div class="flex flex-wrap gap-2">
                                    @for (int i = 0; i < p.Tech.Length; i++)
                                    {
                                        var tech = p.Tech[i];
                                        <span class="font-mono text-muted text-[0.65rem] tracking-[0.08em] uppercase">
                                            @tech
                                            @if (i < p.Tech.Length - 1)
                                            {
                                                <span class="ml-2 text-border-subtle">/</span>
                                            }
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="flex flex-col items-start lg:items-end gap-2">
                                <span class="font-mono text-muted text-xs">@p.Year</span>
                                <a href="@p.Live" class="font-mono text-xs uppercase tracking-[0.1em] text-accent no-underline hover:underline">[ LIVE DEMO ]</a>
                                <a href="@p.Github" class="font-mono text-xs uppercase tracking-[0.1em] text-muted no-underline transition-colors duration-150 hover:text-white">[ GITHUB ]</a>
                            </div>
                        </div>
                    }
                </section>

                <!-- Hackathon Log -->
                <section class="px-8 py-16 lg:px-16 anim-5">
                    <h2 class="font-display font-bold -tracking-[0.02em] text-xl uppercase text-white">HACKATHON &amp; OPEN SOURCE LOG</h2>
                    <p class="font-mono text-muted text-xs uppercase tracking-[0.15em] mt-2 mb-8">
                        Competition record &amp; notable contributions
                    </p>
                    <div class="border border-border-subtle overflow-hidden mt-8">
                        <div class="grid grid-cols-[80px_1fr_1fr_auto] items-center gap-4 px-6 py-3 border-b border-border-subtle bg-surface">
                            @foreach (var h in new[] { "YEAR", "EVENT", "AWARD", "STATUS" })
                            {
                                <span class="font-mono text-muted text-xs uppercase tracking-[0.1em]">@h</span>
                            }
                        </div>
                        @for (int i = 0; i < hackathonLog.Length; i++)
                        {
                            var row = hackathonLog[i];
                            <div class="grid grid-cols-[80px_1fr_1fr_auto] items-center gap-4 px-6 py-4 border-b border-border-subtle last:border-b-0 @(i % 2 != 0 ? "bg-surface-alt" : "")">
                                <span class="font-mono text-muted text-xs">@row.Year</span>
                                <span class="font-mono text-white text-xs">@row.Event</span>
                                <span class="font-mono text-muted text-xs">@row.Award</span>
                                <span class="font-mono text-[0.6rem] tracking-[0.1em] uppercase font-bold px-2 py-0.5 whitespace-nowrap @(row.Badge == "WINNER" ? "bg-accent text-canvas" : "border border-muted text-muted bg-transparent")">@row.Badge</span>
                            </div>
                        }
                    </div>
                </section>
            </div>
        }
        else if (currentPage == "about")
        {
            <div class="anim-fade">
                <!-- Bio & Philosophy -->
                <section class="relative overflow-hidden border-b border-border-subtle">
                    <div class="font-display text-border-subtle text-[clamp(6rem,20vw,18rem)] leading-none absolute top-12 -right-[0.02em] select-none font-extrabold -tracking-[0.04em] pointer-events-none">03</div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 border-b border-border-subtle">
                        <div class="p-8 lg:p-16 border-b lg:border-b-0 lg:border-r border-border-subtle flex flex-col justify-end anim-1">
                            <p class="font-mono text-muted text-xs uppercase tracking-[0.15em] mb-8">03 / ABOUT</p>
                            <div class="relative border border-border-subtle aspect-[4/5] max-w-[380px] overflow-hidden mb-8">
                                <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=760&h=950&fit=crop&auto=format"
                                     alt="Alex Kim"
                                     class="w-full h-full object-cover block grayscale-[0.3] contrast-[1.05]" />
                                <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a]/40 to-transparent pointer-events-none"></div>
                            </div>
                            <div class="font-mono text-muted text-xs leading-[1.6]">
                                <div>ALEX KIM — SOFTWARE ENGINEER</div>
                                <div>SAN FRANCISCO, CA</div>
                                <div class="text-accent mt-1">AVAILABLE FOR CONTRACT WORK</div>
                            </div>
                        </div>

                        <div class="p-8 lg:p-16 anim-2">
                            <h1 class="font-display font-extrabold -tracking-[0.03em] text-[clamp(2rem,4vw,3.5rem)] uppercase text-white leading-none mb-8">
                                CRAFT IS<br />
                                <span class="font-serif italic font-normal">the work.</span>
                            </h1>
                            <div class="font-mono text-muted text-xs leading-[1.8] mb-10 space-y-5">
                                <p>
                                    I've spent six years at the intersection of systems engineering and interface design —
                                    building infrastructure that handles millions of events and products that feel inevitable
                                    to use. I believe the best software is invisible: it disappears into the task.
                                </p>
                                <p>
                                    My background in cognitive science informs how I think about interaction. Systems
                                    should map to human mental models, not force humans to adapt to machine constraints.
                                    This conviction drives every architectural and UX decision I make.
                                </p>
                                <p>
                                    I work best in small, ambitious teams. I bring the same rigour to code review as to
                                    user interviews — both are acts of radical attention.
                                </p>
                            </div>
                            <div>
                                <h3 class="font-mono text-muted text-xs uppercase tracking-[0.15em] mb-4">PRIMARY STACK</h3>
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var tech in primaryStack)
                                    {
                                        <span class="font-mono border border-border-subtle text-white px-3 py-1 text-[0.65rem] tracking-[0.1em] uppercase">@tech</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Experience Timeline -->
                <section class="px-8 py-16 lg:px-16 border-b border-border-subtle anim-3">
                    <h2 class="font-display font-bold -tracking-[0.02em] text-xl uppercase text-white mb-12">EXPERIENCE</h2>
                    <div>
                        @foreach (var item in timeline)
                        {
                            <div class="flex flex-col lg:grid lg:grid-cols-[280px_1fr] gap-6 py-10 border-t border-border-subtle">
                                <div class="font-display font-extrabold -tracking-[0.03em] text-white text-[clamp(1.25rem,2vw,1.75rem)]">@item.Year</div>
                                <div>
                                    <div class="font-display font-bold text-white text-lg uppercase mb-1">@item.Role</div>
                                    <div class="font-mono text-accent text-xs uppercase tracking-[0.1em] mb-4">@item.Org</div>
                                    <p class="font-mono text-muted max-w-[56ch] text-xs leading-[1.6]">@item.Desc</p>
                                </div>
                            </div>
                        }
                        <div class="border-t border-border-subtle"></div>
                    </div>
                </section>

                <!-- Contact Terminal -->
                <section class="px-8 py-16 lg:px-16 anim-4">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
                        <div>
                            <h2 class="font-display font-bold -tracking-[0.02em] text-xl uppercase text-white">CONTACT</h2>
                            <p class="font-mono text-muted text-xs uppercase tracking-[0.15em] mt-2 mb-8">
                                Transmission terminal — open for new work
                            </p>
                            <EditForm Model="@contactForm" OnValidSubmit="HandleSubmit">
                                <div class="mb-4">
                                    <label class="block font-mono text-muted text-xs uppercase tracking-[0.1em] mb-2">YOUR_NAME</label>
                                    <InputText @bind-Value="contactForm.Name" required placeholder="Alex Johnson" class="font-mono bg-surface border border-border-subtle text-white px-4 py-3 text-sm w-full outline-none transition-colors duration-150 focus:border-accent placeholder:text-dim" />
                                </div>
                                <div class="mb-4">
                                    <label class="block font-mono text-muted text-xs uppercase tracking-[0.1em] mb-2">EMAIL_ADDR</label>
                                    <InputText @bind-Value="contactForm.Email" type="email" required placeholder="alex@company.io" class="font-mono bg-surface border border-border-subtle text-white px-4 py-3 text-sm w-full outline-none transition-colors duration-150 focus:border-accent placeholder:text-dim" />
                                </div>
                                <div class="mb-4">
                                    <label class="block font-mono text-muted text-xs uppercase tracking-[0.1em] mb-2">MESSAGE</label>
                                    <InputTextArea @bind-Value="contactForm.Message" rows="5" required placeholder="Tell me about what you're building..." class="font-mono bg-surface border border-border-subtle text-white px-4 py-3 text-sm w-full outline-none transition-colors duration-150 focus:border-accent placeholder:text-dim min-h-[120px] resize-y" />
                                </div>
                                <button type="submit" class="font-mono border border-accent bg-accent text-canvas px-8 py-3.5 text-xs tracking-[0.15em] font-bold cursor-pointer uppercase w-full block transition-colors duration-150 hover:bg-canvas hover:text-accent">
                                    @(isSent ? "[ MESSAGE SENT ✓ ]" : "[ TRANSMIT MESSAGE ]")
                                </button>
                            </EditForm>
                        </div>

                        <div class="flex flex-col justify-between">
                            <div>
                                <h3 class="font-mono text-muted text-xs uppercase tracking-[0.15em] mb-6">FIND ME ON</h3>
                                <div>
                                    @foreach (var s in socialLinks)
                                    {
                                        <a href="@s.Url" class="flex justify-between items-center py-4 border-t border-border-subtle last:border-b last:border-border-subtle no-underline group">
                                            <span class="font-mono text-muted text-xs uppercase tracking-[0.1em] transition-colors duration-150 group-hover:text-white">@s.Label</span>
                                            <span class="font-mono text-white text-xs transition-colors duration-150 group-hover:text-accent">@s.Handle →</span>
                                        </a>
                                    }
                                </div>
                            </div>
                            <div class="font-mono text-dim text-xs mt-12">
                                © 2026 ALEX KIM. DESIGNED &amp; BUILT FROM SCRATCH.
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        }
        else if (currentPage == "reviews")
        {
            <div class="anim-fade">
                <!-- Reviews Header & Stats Overview -->
                <section class="relative px-8 pt-20 pb-12 lg:px-16 border-b border-border-subtle overflow-hidden">
                    <div class="font-display text-border-subtle text-[clamp(6rem,20vw,18rem)] leading-none absolute top-12 -right-[0.02em] select-none font-extrabold -tracking-[0.04em] pointer-events-none">04</div>
                    <p class="font-mono text-muted text-xs uppercase tracking-[0.15em] mb-8 anim-1">04 / REVIEWS &amp; RATINGS</p>
                    <h1 class="font-display font-extrabold -tracking-[0.03em] text-[clamp(2.5rem,5vw,3.75rem)] text-white uppercase mb-4 anim-2">
                        PEER RATINGS &amp;<br />
                        <span class="text-accent">FEEDBACK</span> LOG
                    </h1>
                    <p class="font-mono text-muted max-w-[60ch] text-xs leading-[1.7] mb-10 anim-3">
                        Interactive review and rating terminal. Rate portfolio craft, project engineering, or leave a critique below.
                    </p>

                    <!-- Score Metrics Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-6 border-t border-border-subtle anim-4">
                        <!-- Metric 1: Average Rating -->
                        <div class="border border-border-subtle bg-surface p-6">
                            <div class="flex items-baseline gap-3">
                                <span class="font-display font-extrabold text-4xl text-white">@AverageRating.ToString("0.0")</span>
                                <span class="font-mono text-xs text-muted">/ 5.0 SCORE</span>
                            </div>
                            <div class="mt-3 flex items-center gap-2">
                                <div class="flex text-accent">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        var isLit = s <= (int)Math.Round(AverageRating);
                                        <svg class="w-4 h-4 @(isLit ? "fill-accent text-accent" : "fill-none text-dim")" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                        </svg>
                                    }
                                </div>
                                <span class="font-mono text-xs text-muted">(@reviewsList.Count Total Reviews)</span>
                            </div>
                        </div>

                        <!-- Metric 2: Rating Distribution Bar -->
                        <div class="border border-border-subtle bg-surface p-6 flex flex-col justify-center gap-1.5">
                            @for (int r = 5; r >= 1; r--)
                            {
                                var starNum = r;
                                var count = reviewsList.Count(x => x.Rating == starNum);
                                var pct = reviewsList.Count > 0 ? (count * 100) / reviewsList.Count : 0;
                                <div class="flex items-center gap-2 font-mono text-[0.65rem]">
                                    <span class="w-6 text-muted">@starNum ★</span>
                                    <div class="flex-1 h-1.5 bg-canvas overflow-hidden border border-border-subtle">
                                        <div class="h-full bg-accent transition-all duration-300" style="width: @pct%"></div>
                                    </div>
                                    <span class="w-8 text-right text-dim">@count</span>
                                </div>
                            }
                        </div>

                        <!-- Metric 3: Positive Sentiment -->
                        <div class="border border-border-subtle bg-surface p-6 flex flex-col justify-between">
                            <div>
                                <div class="font-mono text-muted text-xs uppercase tracking-wider mb-1">RECOMMENDATION RATE</div>
                                <div class="font-display font-extrabold text-3xl text-accent">@PositiveSentimentPercent%</div>
                            </div>
                            <div class="font-mono text-[0.7rem] text-muted">
                                @reviewsList.Count(r => r.Rating >= 4) out of @reviewsList.Count reviewers rated 4 or 5 stars.
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Two Column Layout: Rating Form + Reviews Feed -->
                <section class="px-8 py-16 lg:px-16 anim-5">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
                        
                        <!-- Left Column: Interactive Review Submission Form (5 cols) -->
                        <div class="lg:col-span-5">
                            <div class="sticky top-20">
                                <div class="flex items-center justify-between mb-4">
                                    <h2 class="font-display font-bold -tracking-[0.02em] text-xl uppercase text-white">SUBMIT A REVIEW</h2>
                                    <span class="font-mono text-[0.65rem] border border-accent/40 bg-accent/10 text-accent px-2 py-0.5 uppercase tracking-wider font-semibold">
                                        LIVE INTERACTIVE
                                    </span>
                                </div>
                                <p class="font-mono text-muted text-xs uppercase tracking-[0.12em] mb-8">
                                    Select a rating scale &amp; write your feedback
                                </p>

                                @if (isReviewSubmitted)
                                {
                                    <!-- Thank You / Success State Banner -->
                                    <div class="border border-accent bg-surface p-8 anim-fade">
                                        <div class="flex items-center gap-3 text-accent mb-4">
                                            <div class="w-8 h-8 rounded-full border border-accent bg-accent/20 flex items-center justify-center font-bold text-lg">
                                                ✓
                                            </div>
                                            <span class="font-display font-bold text-lg text-white uppercase">
                                                THANK YOU FOR YOUR REVIEW!
                                            </span>
                                        </div>
                                        <p class="font-mono text-muted text-xs leading-relaxed mb-6">
                                            Your feedback has been recorded and instantly appended to the public review stream on the right.
                                        </p>
                                        
                                        <!-- Mini preview card of submission -->
                                        @if (lastSubmittedReview != null)
                                        {
                                            <div class="border border-border-subtle bg-canvas p-4 mb-6">
                                                <div class="flex justify-between items-center mb-2">
                                                    <span class="font-mono text-xs font-bold text-white uppercase">@lastSubmittedReview.Author</span>
                                                    <StarRating Value="@lastSubmittedReview.Rating" ReadOnly="true" Size="sm" ShowScoreText="false" ShowScaleButtons="false" />
                                                </div>
                                                <div class="font-mono text-[0.7rem] text-accent mb-1 uppercase font-semibold">“@lastSubmittedReview.Title”</div>
                                                <div class="font-mono text-[0.7rem] text-muted line-clamp-2">@lastSubmittedReview.Comment</div>
                                            </div>
                                        }

                                        <button type="button"
                                                @onclick="ResetReviewForm"
                                                class="font-mono border border-accent bg-accent text-canvas px-6 py-3 text-xs tracking-[0.15em] font-bold cursor-pointer uppercase w-full block transition-colors duration-150 hover:bg-canvas hover:text-accent">
                                            [ + WRITE ANOTHER REVIEW ]
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <!-- Review Submission Form -->
                                    <EditForm Model="@reviewForm" OnValidSubmit="HandleReviewSubmit" class="space-y-5">
                                        <!-- Core Feature 1: Interactive Rating Input (Stars + Number Scale) -->
                                        <div class="border border-border-subtle bg-surface p-5">
                                            <label class="block font-mono text-accent text-xs uppercase tracking-[0.12em] font-bold mb-3">
                                                ★ INTERACTIVE RATING SCALE (1 - 5)
                                            </label>
                                            <StarRating @bind-Value="reviewForm.Rating" Size="md" ShowScoreText="true" ShowScaleButtons="true" />
                                        </div>

                                        <!-- Category Selector -->
                                        <div>
                                            <label class="block font-mono text-muted text-xs uppercase tracking-[0.1em] mb-2">TOPIC CATEGORY</label>
                                            <div class="flex flex-wrap gap-2">
                                                @foreach (var cat in reviewCategories)
                                                {
                                                    <button type="button"
                                                            @onclick="() => reviewForm.Category = cat"
                                                            class="font-mono text-[0.65rem] px-3 py-1.5 border transition-all duration-150 cursor-pointer uppercase tracking-wider @(reviewForm.Category == cat ? "border-accent bg-accent text-canvas font-bold" : "border-border-subtle bg-surface text-muted hover:border-white hover:text-white")">
                                                        @cat
                                                    </button>
                                                }
                                            </div>
                                        </div>

                                        <!-- Reviewer Name -->
                                        <div>
                                            <label class="block font-mono text-muted text-xs uppercase tracking-[0.1em] mb-2">
                                                YOUR_NAME / HANDLE <span class="text-accent">*</span>
                                            </label>
                                            <InputText @bind-Value="reviewForm.Name" required placeholder="e.g. Maya Lin" class="font-mono bg-surface border border-border-subtle text-white px-4 py-3 text-sm w-full outline-none transition-colors duration-150 focus:border-accent placeholder:text-dim" />
                                        </div>

                                        <!-- Reviewer Role -->
                                        <div>
                                            <label class="block font-mono text-muted text-xs uppercase tracking-[0.1em] mb-2">
                                                ROLE / COMPANY (OPTIONAL)
                                            </label>
                                            <InputText @bind-Value="reviewForm.Role" placeholder="e.g. Product Designer at Linear" class="font-mono bg-surface border border-border-subtle text-white px-4 py-3 text-sm w-full outline-none transition-colors duration-150 focus:border-accent placeholder:text-dim" />
                                        </div>

                                        <!-- Review Headline / Title -->
                                        <div>
                                            <label class="block font-mono text-muted text-xs uppercase tracking-[0.1em] mb-2">
                                                REVIEW_TITLE / HEADLINE <span class="text-accent">*</span>
                                            </label>
                                            <InputText @bind-Value="reviewForm.Title" required placeholder="e.g. Exceptional typography and fast interactions" class="font-mono bg-surface border border-border-subtle text-white px-4 py-3 text-sm w-full outline-none transition-colors duration-150 focus:border-accent placeholder:text-dim" />
                                        </div>

                                        <!-- Core Feature 2: Review Comment Textarea -->
                                        <div>
                                            <div class="flex justify-between items-center mb-2">
                                                <label class="block font-mono text-muted text-xs uppercase tracking-[0.1em]">
                                                    COMMENT / DETAILED_REVIEW <span class="text-accent">*</span>
                                                </label>
                                                <span class="font-mono text-[0.65rem] text-dim">
                                                    @(reviewForm.Comment?.Length ?? 0) chars
                                                </span>
                                            </div>
                                            <InputTextArea @bind-Value="reviewForm.Comment" required rows="4" placeholder="Write your constructive feedback, observations on UX, code architecture, or overall impressions..." class="font-mono bg-surface border border-border-subtle text-white px-4 py-3 text-sm w-full outline-none transition-colors duration-150 focus:border-accent placeholder:text-dim min-h-[110px] resize-y" />
                                        </div>

                                        <!-- Submit Button -->
                                        <button type="submit" class="font-mono border border-accent bg-accent text-canvas px-8 py-3.5 text-xs tracking-[0.15em] font-bold cursor-pointer uppercase w-full block transition-all duration-150 hover:bg-canvas hover:text-accent hover:shadow-[0_0_20px_rgba(184,255,0,0.2)]">
                                            [ TRANSMIT REVIEW ➔ ]
                                        </button>
                                    </EditForm>
                                }
                            </div>
                        </div>

                        <!-- Right Column: Live Community Reviews Stream (7 cols) -->
                        <div class="lg:col-span-7">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                                <div>
                                    <h3 class="font-display font-bold -tracking-[0.02em] text-xl uppercase text-white">
                                        COMMUNITY REVIEWS (@FilteredReviewsCount)
                                    </h3>
                                    <p class="font-mono text-muted text-xs mt-1">
                                        Showing latest community feedback and ratings
                                    </p>
                                </div>

                                <!-- Star Filter Buttons -->
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var filterOption in ratingFilters)
                                    {
                                        <button type="button"
                                                @onclick="() => selectedRatingFilter = filterOption"
                                                class="font-mono text-[0.65rem] px-3 py-1.5 border transition-all duration-150 cursor-pointer uppercase tracking-wider @(selectedRatingFilter == filterOption ? "border-accent bg-accent text-canvas font-bold" : "border-border-subtle bg-surface text-muted hover:border-white hover:text-white")">
                                            @filterOption
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Review Cards List -->
                            <div class="space-y-4">
                                @{
                                    var displayReviews = GetFilteredReviews().ToList();
                                }
                                @if (displayReviews.Count == 0)
                                {
                                    <div class="border border-border-subtle bg-surface p-12 text-center font-mono text-muted text-xs">
                                        No reviews found matching the filter "@selectedRatingFilter". Be the first to leave one!
                                    </div>
                                }
                                else
                                {
                                    @foreach (var review in displayReviews)
                                    {
                                        <ReviewCard Review="@review" />
                                    }
                                }
                            </div>
                        </div>

                    </div>
                </section>
            </div>
        }
    </main>
</div>

